using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("Hello World");
    }
}

IL EQUIVALENT

//Creates an assembly named HelloWorld
//Metadata generated by the compiler
.assembly HelloWorld
{
}

//This program depends on mscorlib.dll
//In .NET Framework, mscorlib contains:
// System.Object
// System.String
// System.Console
// Int32
// Exception
//c# equivalent: using System;
.assembly extern mscorlib
{
}

//Defines the executable file
.module HelloWorld.exe


.class private auto ansi Program
       extends [mscorlib]System.Object
{
    .method private hidebysig static void Main() cil managed
    {
        .entrypoint

        ldstr      "Hello World"
        call       void [mscorlib]System.Console::WriteLine(string)
        ret
    }

    .method public hidebysig specialname rtspecialname
            instance void .ctor() cil managed
    {
        ldarg.0
        call instance void [mscorlib]System.Object::.ctor()
        ret
    }
}
